# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - CRITICAL: Never commit these!
# Ignore ALL .env files EXCEPT .example and .template files
.env*
!.env.example
!.env.template
!.env*.example
!.env*.template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production
.env.staging

# vercel
.vercel

# netlify
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets and sensitive files
*.key
*.pem
*.p12
*.pfx
secrets/
.secrets

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

